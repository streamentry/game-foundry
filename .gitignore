# Godot 4
# Version export_presets.cfg; confidential export_credentials.cfg lives in ignored .godot/.
**/.godot/
**/.import/
**/export.cfg
**/*.translation
# Exported binaries and bundles
build/
dist/
*.apk
*.aab
*.ipa
*.pck
*.app/
*.dmg
*.zip
# Python / OS / editors
__pycache__/
*.py[cod]
.venv/
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
# Never commit Apple certificates, keys or store credentials
*.p12
*.mobileprovision
AuthKey_*.p8
google-services.json
GoogleService-Info.plist

# Authenticated Apple research exports: keep snapshots local/private
.apple-results/
docs/research/raw/

# Evergrove Unity project cache, IDE and local build output.
/games/evergrove/Library/
/games/evergrove/Temp/
/games/evergrove/Obj/
/games/evergrove/Logs/
/games/evergrove/Build/
/games/evergrove/Builds/
/games/evergrove/UserSettings/
/games/evergrove/Assets/Scenes/
/.evergrove-evidence/
/artifacts/evergrove-first-minute/
/evergrove-unity*.log
/games/evergrove/.vs/
/games/evergrove/*.sln
/games/evergrove/Assembly-CSharp*.csproj
**/bin/
**/obj/

# Cloudflare preview: never commit local state, dependencies or secrets.
/backend/evergrove/node_modules/
/backend/evergrove/.wrangler/
/backend/evergrove/.dev.vars
/backend/evergrove/.dev.vars.*

# Playwright CLI local snapshots/session state.
.playwright-cli/
