.vscode/
# Never commit Apple certificates, keys or store credentials
*.p12
*.mobileprovision
AuthKey_*.p8
google-services.json
GoogleService-Info.plist

# Authenticated Apple research exports: keep snapshots local/private
.apple-results/
docs/research/raw/
