extends RefCounted
## Original 3x3 single-loop puzzles, generated by simple-cycle enumeration
## and individually screened for one solution under the visible clues.
const COUNT: int = 6
const FIXTURES: Array = [{"name":"Warming Up","clues":[-1,1,-1,-1,1,2,-1,-1,3],"solution":[4,5,6,12,13,19,20,23]},{"name":"Copper Window","clues":[1,2,2,-1,-1,2,-1,1,-1],"solution":[2,3,4,6,10,13,16,18]},{"name":"Paper Trail","clues":[-1,2,2,-1,-1,3,2,3,-1],"solution":[0,1,2,5,8,11,13,14,17,18,19,22]},{"name":"Roundabout","clues":[0,1,-1,-1,-1,3,1,-1,-1],"solution":[9,10,11,13,17,18,19,22]},{"name":"Garden Ring","clues":[3,-1,-1,-1,-1,-1,2,2,1],"solution":[0,1,3,8,9,12,15,19,21,22]},{"name":"Last Light","clues":[0,2,-1,-1,-1,-1,1,2,-1],"solution":[4,5,6,9,10,13,17,20,22,23]}]
static func make(index: int) -> Dictionary:
    var fixture: Dictionary = FIXTURES[clampi(index, 0, COUNT - 1)]
    return {"name": fixture["name"], "size": 3, "clues": fixture["clues"].duplicate(true)}
static func reference_edges(index: int) -> Array:
    return FIXTURES[clampi(index, 0, COUNT - 1)]["solution"].duplicate()
