---
import SiteLayout from "../layouts/SiteLayout.astro";

const items = [
  {
    question: "Where can I download Mosselora?",
    answer: "It is not available in the app stores yet. Store links will appear here after the mobile builds pass review."
  },
  {
    question: "How do I reset the browser preview?",
    answer: "Reload the preview page. It does not save your puzzle or choice."
  },
  {
    question: "Does the preview need an account?",
    answer: "No. The one-puzzle browser preview runs without an account or connection to a game server."
  }
];
---

<SiteLayout title="Support | Mosselora" description="Help and support information for Mosselora.">
  <article class="text-page section-wrap">
    <p class="eyebrow">Support</p>
    <h1>Help for the preview.</h1>
    <p class="page-lede">Mosselora is still in development. The mobile game is not available for download, and a direct support contact will be published before store release.</p>
    <div class="question-list">
      {items.map((item) => (
        <details open>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </article>
</SiteLayout>
