{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mosselora-world-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "workers_dev": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://mosselora.com"
  },
  "routes": [
    { "pattern": "api.mosselora.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORLD", "class_name": "WorldState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldState"] }
  ]
}
