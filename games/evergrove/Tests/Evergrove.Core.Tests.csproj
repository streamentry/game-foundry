<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Core LocalPlaytest is a research recorder; tests exercise it, player builds do not compile it. -->
    <DefineConstants>$(DefineConstants);EVERGROVE_RESEARCH_TOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Include="../Assets/ThirdParty/BidiSharp/*.cs" Link="ThirdParty/BidiSharp/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
