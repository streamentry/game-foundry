{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evergrove-world-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "WORLD", "class_name": "WorldState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorldState"] }
  ]
}
